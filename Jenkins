pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh './mvnw clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t myapp:${env.BUILD_NUMBER} ."
            }
        }

        stage('Deploy') {
            steps {
                sh "docker run -d -p 8080:8080 myapp:${env.BUILD_NUMBER}"
            }
        }
    }
}
